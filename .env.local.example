NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Apify API token — checks whether inspo posts still exist
APIFY_TOKEN=

# Instagram session cookies as a JSON array — without these the check cannot
# tell a deleted post from an age-restricted one and never deletes anything
INSTAGRAM_SESSION_COOKIES=
